# docker compose 的本地变量。复制为 .env 后按需修改：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交真实密码。
# 不复制也能起：下面就是 compose 文件里的回退默认值。

# Qdrant 映射到宿主机的端口（改这里时，LightRAG/.env 的 QDRANT_URL 也要跟着改）
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# MySQL 映射到宿主机的端口。默认 3307：本机可能已经有 MySQL84 占着 3306。
# 使用容器 MySQL 时，Java 启动前要设 DB_PORT=3307。
MYSQL_HOST_PORT=3307

# 仅本地开发默认值，生产请换掉
MYSQL_ROOT_PASSWORD=root
# 必须与 Java 启动时设置的 DB_PASSWORD 一致
DB_PASSWORD=123456
