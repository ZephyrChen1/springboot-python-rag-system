# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交。
# 复制命令：cp .env.example .env

# ---- 大模型 / 向量模型（DashScope 兼容模式）----
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 生成模型（默认 qwen-max；也可按账号额度改成 qwen-plus 等兼容模型）
# LLM_MODEL=qwen-max

# ---- Qdrant 向量库 ----
# 本地 Docker：docker run -d --name qdrant -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- RAG API 服务鉴权（留空则关闭鉴权，仅限内网/开发）----
RAG_API_KEY=

# ---- 可选调优参数（不填则用 config_data.py 中的默认值）----
# LIGHTRAG_LANGUAGE=Simplified Chinese
# LIGHTRAG_CHUNK_TOKEN_SIZE=2400
# LIGHTRAG_TOP_K=20
# LIGHTRAG_MAX_HISTORY_TURNS=10

# ---- Agentic RAG（详见 docs/Agent化改造实施计划.md）----
# AGENT_ENABLED=1
# AGENT_MAX_STEPS=6
# AGENT_STEP_TIMEOUT_S=90
# AGENT_HISTORY_MAX_TURNS=10
# 单条历史消息回放上限（字符）；防止长回答把上下文撑爆
# AGENT_HISTORY_MAX_CHARS=2000
# AGENT_MAX_CONCURRENT_RUNS=2

# 写工具总闸门。默认 0：模型看不到 kb_ingest / kb_delete。
# 打开前请确认已实现人工确认，否则等于把删除权限交给一个匿名接口。
# AGENT_ALLOW_WRITE_TOOLS=0
# AGENT_REQUIRE_CONFIRM=1
# AGENT_CONFIRM_TTL_S=120

# ---- 跨进程状态（入库任务注册表 / KB 写锁）----
# 入库任务状态库：API 重启或请求落到别的进程后仍能查询 job
# INGEST_JOB_DB=./crawler_state/rag_jobs.db
# 入库与删除共用的跨进程写锁（crawler 另用自己的 news.lock）
# INGEST_LOCK_PATH=./crawler_state/ingest.lock
# 删除文档时等待写锁的最长秒数
# KB_DELETE_LOCK_TIMEOUT_S=30

# 外部能力（web_search 未配置 provider 时不会注册该工具）
# AGENT_WEB_SEARCH_ENABLED=0
# AGENT_WEB_SEARCH_URL=

# 暂存区与 trace 目录（运行时生成）
# AGENT_STAGE_DIR=./uploads
# AGENT_TRACE_DIR=./agent_runs
# 暂存文件大小上限（字节），默认 100MB，与 Spring multipart 上限对齐
# AGENT_STAGE_MAX_BYTES=104857600

# Phase 4：业务数据查询走 Java BFF 的受限接口（不直连 MySQL）
# 未配置 key 时不会注册 biz_query 工具。
# AGENT_BIZ_QUERY_URL=http://localhost:8080/internal/rag/query
# AGENT_BIZ_QUERY_KEY=

# ---- 自动新闻抓取（独立进程 python -m news_ingest，不属于 FastAPI）----
# 只抓官方 RSS/sitemap，经规则 + LLM 过滤后通过 /v1/kb/upload 入库。
# NEWS_API_BASE_URL=http://127.0.0.1:8102
# 留空时回退 RAG_API_KEY
# NEWS_API_KEY=
# 每轮处理上限：0 = 不限（默认处理所有到期文章）
# NEWS_MAX_ARTICLES_PER_RUN=0
# NEWS_MAX_PER_SOURCE_PER_RUN=0
# 日期窗口，抓取/预筛/过期清理共用；0 关闭日期过滤和清理
# NEWS_SINCE_DAYS=7
# NEWS_IMPORTANCE_THRESHOLD=3
# NEWS_INTERVAL_MINUTES=360
# 可选：覆盖 LLM（默认复用 LLM_MODEL / DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL）
# NEWS_LLM_MODEL=
# NEWS_LLM_API_KEY=
# NEWS_LLM_BASE_URL=
# 状态库/日志目录（相对路径按启动 cwd 解析）
# NEWS_STATE_DB=./crawler_state/news.db
# NEWS_RUN_LOG_DIR=./crawler_state/runs
# NEWS_LOCK_FILE=./crawler_state/news_ingest.lock
# 正文变化是否重新入库（0=只记录新 hash，不重传）
# NEWS_REINGEST_ON_CHANGE=0
