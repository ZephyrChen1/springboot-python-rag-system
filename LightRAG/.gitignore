# ==== 密钥 / 环境变量（务必不要提交）====
.env
.env.*
!.env.example

# ==== Python 编译产物 / 缓存 ====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ==== 虚拟环境 ====
.venv/
venv/
env/
ENV/

# ==== 运行时数据（本地产物，不该进仓库）====
# RAG 向量索引 + LLM 响应缓存 + 上传文档正文
Lightrag_db/
# 会话历史（含用户对话内容）
chat_history/
# 已入库文件的 md5 指纹表
md5.text
# Agent 上传暂存区（原始文件）
uploads/
# Agent run trace（含工具参数与观察结果）
agent_runs/

# ==== IDE / 编辑器 ====
.idea/
.vscode/
*.swp
*.swo

# ==== Claude Code 本地配置 ====
.claude/settings.local.json

# ==== 日志 / 临时文件 ====
*.log
*.tmp
.DS_Store
Thumbs.db
